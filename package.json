{
  "name": "companion-productivity-app",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "npm --prefix app ci",
    "app": "npm --prefix app run dev",
    "build": "npm --prefix app run build",
    "test": "node --test \"app/src/**/*.test.ts\" \"worker/test/*.test.ts\" \"spikes/**/*.test.js\"",
    "typecheck": "npm --prefix app run check && npx --yes --package typescript@5.9 tsc --project worker/tsconfig.json",
    "icons": "node tools/make-icons.js",
    "vapid-keys": "node worker/scripts/make-keys.ts",
    "spikes": "node tools/serve.js",
    "worker:dev": "npx --yes wrangler@4 dev --config worker/wrangler.toml",
    "worker:deploy": "npx --yes wrangler@4 deploy --config worker/wrangler.toml"
  }
}
